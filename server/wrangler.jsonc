{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "microsoft-tasks-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    // Entra tenant this server serves. Left as "organizations" on purpose so
    // that no tenant-specific identifier lives in a public repository.
    //
    // CI overrides it at deploy time from the ENTRA_TENANT_ID GitHub secret:
    //     wrangler deploy --var TENANT_ID:"$ENTRA_TENANT_ID"
    //
    // Do not set the real GUID here, and do not set it as a plaintext variable
    // in the Cloudflare dashboard: `wrangler deploy` replaces dashboard vars
    // with whatever this file declares, so a dashboard value would be silently
    // wiped on the next deploy.
    "TENANT_ID": "organizations",

    // Application (client) ID of the "NCM Claude Tasks" Entra registration.
    // Committed on purpose: a public client's ID is not a secret, it appears in
    // the browser URL on every authorization request, and it is already in the
    // plugin's .mcp.json. The /register endpoint hands this back to clients
    // that insist on dynamic registration.
    "ENTRA_CLIENT_ID": "58617f76-7cf7-4324-8b0c-b74c951e356d",

    // Microsoft Graph endpoint. Change only for national clouds
    // (US Gov: https://graph.microsoft.us/v1.0, 21Vianet: https://microsoftgraph.chinacloudapi.cn/v1.0).
    "GRAPH_BASE": "https://graph.microsoft.com/v1.0",

    // Entra login host. Change only for national clouds.
    "LOGIN_BASE": "https://login.microsoftonline.com",

    // How many Graph pages a single tool call will follow before stopping.
    "MAX_GRAPH_PAGES": "5"

    // Optional. Comma-separated tenant GUIDs allowed to call this server, as a
    // cheap early reject. Set this when TENANT_ID is "organizations" and you
    // want to serve only your own tenant.
    // "ALLOWED_TENANT_IDS": "00000000-0000-0000-0000-000000000000"
  }
}
